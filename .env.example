# Copia este archivo como .env.local y pega tu propia API key de Anthropic.
# Consíguela en https://console.anthropic.com (sección "API Keys").
# NUNCA subas .env.local a GitHub — ya está en .gitignore.
ANTHROPIC_API_KEY=

# Opcional: ID de medición de Google Analytics 4 (empieza con "G-").
# Si se deja vacío, el sitio no carga Google Analytics ni guarda cookies de medición.
# Antes de activarlo, actualiza la sección "Cookies" del aviso de privacidad.
NEXT_PUBLIC_GA_ID=
